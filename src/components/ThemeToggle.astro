---
import { Icon } from "astro-icon/components";
---

<button
  type="button"
  id="theme-toggle"
  aria-label="Toggle dark mode"
  class="text-fg hover:border-accent hover:text-accent border-line grid size-[34px] cursor-pointer place-items-center rounded-md border bg-transparent"
>
  <Icon name="lucide:moon" class="size-4 dark:hidden" />
  <Icon name="lucide:sun" class="hidden size-4 dark:block" />
</button>

<script>
  const root = document.documentElement;
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {
      /* storage blocked: the choice just won't be remembered */
    }
  });
</script>
