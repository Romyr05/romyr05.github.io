---
import Chip from "@components/Chip.astro";
import type { WorkItem } from "@data/work";
import { skills } from "@data/skills";
import { formatDateRange, formatDuration } from "@lib/utils";

type Props = { item: WorkItem };
const { item } = Astro.props;
const meta = [
  item.employmentType,
  item.location,
  formatDuration(item.startDate, item.endDate),
].filter(Boolean);
---

<a
  href={`/work/${item.id}`}
  class="group hover:bg-bg-accent -mx-4 grid grid-cols-1 gap-1 rounded-lg p-4 no-underline transition-colors sm:grid-cols-[120px_1fr] sm:gap-5"
>
  <span class="text-muted font-mono text-xs leading-[1.9]">
    {formatDateRange(item.startDate, item.endDate)}
  </span>
  <div>
    <div class="group-hover:text-accent text-base font-semibold transition-colors">
      {item.title} · {item.company} ↗
    </div>
    <div class="text-muted text-sm">{meta.join(" · ")}</div>
    {item.description && (
      <p class="text-muted mt-2 text-[14.5px]">{item.description}</p>
    )}
    {item.skills && (
      <div class="mt-3 flex flex-wrap gap-2">
        {item.skills.map((s) => (
          <Chip>{skills[s].name}</Chip>
        ))}
      </div>
    )}
  </div>
</a>
