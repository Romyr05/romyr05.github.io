---
import type { EducationItem } from "@data/education";

type Props = { item: EducationItem };
const { item } = Astro.props;
const Tag = item.url ? "a" : "div";
---

<Tag
  href={item.url}
  class="border-line flex snap-start flex-col overflow-hidden rounded-xl border no-underline"
  {...(item.url && { target: "_blank", rel: "noopener noreferrer" })}
>
  {item.image ? (
    <img
      src={item.image}
      alt={`${item.title} certificate`}
      loading="lazy"
      class="border-line aspect-[4/3] w-full border-b object-cover"
    />
  ) : (
    <div class="shot border-line aspect-[4/3] border-b">certificate image</div>
  )}
  <div class="flex flex-col gap-0.5 px-3.5 pt-3 pb-3.5">
    <h3 class="text-[15px] leading-snug font-semibold">{item.title}</h3>
    <span class="text-muted font-mono text-xs">
      Certification · {item.endDate}
    </span>
    <span class="text-muted font-mono text-xs">{item.provider}</span>
  </div>
</Tag>
