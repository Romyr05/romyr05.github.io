---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import SkillIcon from "@components/SkillIcon.astro";
import type { Project } from "@lib/content";

type Props = { project: Project };
const { project } = Astro.props;
const { title, description, image, demoURL, repoURL, skills } = project.data;
---

<a
  href={`/projects/${project.id}`}
  class="group border-line hover:border-accent flex flex-col overflow-hidden rounded-xl border no-underline transition-colors"
>
  {image ? (
    <Image
      src={image}
      alt={title}
      width={640}
      class="border-line aspect-[16/10] w-full border-b object-cover"
    />
  ) : (
    <div class="shot border-line aspect-[16/10] border-b">preview image</div>
  )}
  <div class="flex flex-col gap-1 px-4 pt-3.5 pb-4">
    <h3 class="group-hover:text-accent text-base font-semibold transition-colors">
      {title}
    </h3>
    <p class="text-muted text-sm">{description}</p>
    <div class="text-muted mt-2 flex items-center gap-1.5">
      {demoURL && (
        <Icon name="lucide:external-link" class="size-4" title="Live demo" />
      )}
      {repoURL && (
        <Icon name="simple-icons:github" class="size-4" title="Repository" />
      )}
      {skills.slice(0, 3).map((s) => (
        <SkillIcon skill={s} />
      ))}
    </div>
  </div>
</a>
