---
import { NAV_LINKS } from "@consts";
import ThemeToggle from "@components/ThemeToggle.astro";
import Search from "@components/Search.astro";

const brand = "romyr"; // TODO: header brand text
const path = Astro.url.pathname;
---

<header class="border-line bg-bg sticky top-0 z-10 -mx-4 border-b px-4">
  <div class="mx-auto flex h-(--header-h) max-w-[1120px] items-center justify-end gap-4 sm:justify-between">
    <a
      href="/"
      class="hidden font-mono text-[15px] font-semibold no-underline sm:block"
    >
      {brand}
    </a>
    <nav aria-label="Pages" class="flex items-center gap-0.5 sm:gap-1">
      {NAV_LINKS.map((link) => {
        const active = path.startsWith(link.HREF);
        const isCv = link.HREF === "/cv";
        return (
          <a
            href={link.HREF}
            aria-current={active ? "page" : undefined}
            class:list={[
              "hover:bg-bg-accent hover:text-fg rounded-md px-1.5 py-1.5 font-mono text-xs no-underline sm:px-2.5 sm:text-[13.5px]",
              active || isCv ? "text-fg" : "text-muted",
              isCv && "border-line hover:border-accent border",
            ]}
          >
            {link.LABEL}
          </a>
        );
      })}
      <span class="ml-1 sm:ml-1.5">
        <Search />
      </span>
      <span class="ml-1 sm:ml-1.5">
        <ThemeToggle />
      </span>
    </nav>
  </div>
</header>
