---
/** One CV line: bold title, date on the right, muted subtitle, optional bullets. */
type Props = {
  title: string;
  date: string;
  subtitle?: string;
  bullets?: string[];
};
const { title, date, subtitle, bullets } = Astro.props;
---

<div class="grid grid-cols-[1fr_auto] gap-x-4 gap-y-0.5">
  <span class="font-semibold">{title}</span>
  <span class="text-muted font-mono text-xs leading-[1.9] whitespace-nowrap">
    {date}
  </span>
  {subtitle && <span class="text-muted col-span-full text-sm">{subtitle}</span>}
  {bullets && (
    <ul class="text-fg-accent col-span-full mt-1.5 list-disc pl-5 text-[14.5px]">
      {bullets.map((b) => (
        <li>{b}</li>
      ))}
    </ul>
  )}
</div>
