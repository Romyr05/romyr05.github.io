---
import type { HTMLAttributes } from "astro/types";

/** Pill label. Renders a link when `href` is given; extra attributes pass through. */
type Props = HTMLAttributes<"a">;
const { href, class: className, ...rest } = Astro.props;
const Tag = href ? "a" : "span";
---

<Tag
  href={href}
  class:list={[
    "bg-bg-accent text-fg-accent border-line inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1.5 font-mono text-xs leading-none whitespace-nowrap no-underline",
    href && "hover:border-accent hover:text-accent",
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
