---
import { Icon } from "astro-icon/components";
import { SOCIALS } from "@consts";
---

<div class="flex gap-2.5">
  {SOCIALS.map((s) => (
    <a
      href={s.HREF}
      aria-label={s.NAME}
      class="border-line text-fg-accent hover:text-accent hover:border-accent grid size-9 place-items-center rounded-lg border transition-colors"
      {...(!s.HREF.startsWith("mailto:") && {
        target: "_blank",
        rel: "noopener noreferrer",
      })}
    >
      <Icon name={s.ICON} class="size-[17px]" />
    </a>
  ))}
</div>
