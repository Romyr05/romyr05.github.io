---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import BackLink from "@components/BackLink.astro";
import PageHeader from "@components/PageHeader.astro";
import AchievementItem from "@components/AchievementItem.astro";
import { ACHIEVEMENTS } from "@consts";
import { achievements } from "@data/achievements";
import { sortByDateDesc } from "@lib/utils";

const sorted = sortByDateDesc(achievements, (a) => a.date);
---

<Layout title={ACHIEVEMENTS.TITLE} description={ACHIEVEMENTS.DESCRIPTION}>
  <Container>
    <BackLink href="/">Home</BackLink>
    <PageHeader title={ACHIEVEMENTS.TITLE} lede={ACHIEVEMENTS.DESCRIPTION} />
    <div class="flex flex-col">
      {sorted.map((a) => (
        <AchievementItem achievement={a} />
      ))}
    </div>
  </Container>
</Layout>
