# Copy to .env (never commit .env).

# GitHub fine-grained personal access token, read-only public access.
# Used at build time only for the contribution graph. Without it, a sample graph is shown.
GITHUB_TOKEN=

# GoatCounter site code (the "romyr" in romyr.goatcounter.com).
# Without it, the visitor counter shows "—" and no analytics script is added.
PUBLIC_GOATCOUNTER_CODE=
